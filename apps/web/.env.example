# Copy this file to .env.local and fill in your values.
# Never commit .env or .env.local to version control.

# GraphQL API
VITE_GRAPHQL_URL=http://localhost:3000/graphql

# Keycloak
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=smartsense-marketplace
VITE_KEYCLOAK_CLIENT_ID=smartsense-web

# Auth session behavior — docs/authentication.md § Required Environment Variables
VITE_AUTH_SILENT_CHECK_SSO_URL=/silent-check-sso.html
VITE_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_AUTH_SESSION_WARNING_SECONDS=60
