# App
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartsense_marketplace

# GraphQL
GRAPHQL_DEBUG=false
GRAPHQL_INTROSPECTION=true
GRAPHQL_PLAYGROUND=false

# CORS — comma-separated browser origin allowlist. Leave empty for permissive
# (local dev); set to the web app origin(s) in production, e.g.
# CORS_ALLOWED_ORIGINS=https://app.smartsense.example
CORS_ALLOWED_ORIGINS=

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=smartsense-marketplace
KEYCLOAK_API_CLIENT_ID=smartsense-api
KEYCLOAK_API_CLIENT_SECRET=smartsense-api-dev-secret-change-me
# Optional overrides — sensible defaults are derived/applied if omitted
# KEYCLOAK_JWKS_URI=http://localhost:8080/realms/smartsense-marketplace/protocol/openid-connect/certs
# KEYCLOAK_JWKS_CACHE_TTL_SECONDS=600
# JWT_CLOCK_TOLERANCE_SECONDS=5

# Keycloak Admin API (KeycloakAdminService — SM-336) — service-account client used only for
# invite/password-reset. Optional: absent in an environment that hasn't provisioned it yet;
# KeycloakAdminService fails closed at the call site, not at app boot, when these are empty.
KEYCLOAK_ADMIN_CLIENT_ID=smartsense-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=smartsense-api-admin-dev-secret-change-me
